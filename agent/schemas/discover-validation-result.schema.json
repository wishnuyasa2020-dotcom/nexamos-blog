{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NexaMOS Google Discover Validation Result Schema",
  "type": "object",
  "required": [
    "articleId",
    "checks",
    "issues",
    "recommendations",
    "dimensions",
    "score",
    "classification",
    "eligibility",
    "criticalIneligibilityReasons",
    "validatedAt",
    "policyVersion"
  ],
  "properties": {
    "articleId": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checkId", "dimension", "status", "scoreContribution", "summary"],
        "properties": {
          "checkId": { "type": "string" },
          "dimension": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "WARNING", "FAIL"] },
          "scoreContribution": { "type": "number", "minimum": 0 },
          "summary": { "type": "string" },
          "details": { "type": "object" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "checkId", "dimension", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "checkId": { "type": "string" },
          "dimension": { "type": "string" },
          "severity": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL"] },
          "message": { "type": "string" },
          "location": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "title", "description", "suggestedAction"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "EDITORIAL_IMPROVEMENT",
              "TITLE_IMPROVEMENT",
              "VISUAL_IMPROVEMENT",
              "TOPICAL_CLUSTER_IMPROVEMENT",
              "TECHNICAL_FIX",
              "FRESHNESS_REVIEW",
              "PAGE_EXPERIENCE_REVIEW"
            ]
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "suggestedAction": { "type": "string" },
          "crossEngineDestination": {
            "type": "string",
            "enum": ["EDITORIAL", "SEO_TECHNICAL", "CONTENT_STRATEGY", "VISUAL_DESIGN"]
          }
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 100 },
    "classification": {
      "type": "string",
      "enum": ["STRONG", "READY", "READY_WITH_WARNINGS", "REVISION_REQUIRED", "INELIGIBLE"]
    },
    "eligibility": {
      "type": "string",
      "enum": ["ELIGIBLE", "ELIGIBILITY_WARNING", "INELIGIBLE"]
    },
    "criticalIneligibilityReasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validatedAt": { "type": "string", "format": "date-time" },
    "policyVersion": { "type": "string" }
  }
}
