{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexaMOS Distribution Issue Schema",
  "type": "object",
  "required": [
    "code",
    "severity",
    "sourceValidators",
    "message",
    "route",
    "blocking"
  ],
  "properties": {
    "code": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["INFO", "WARNING", "REVISION", "CRITICAL"]
    },
    "sourceValidators": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["EDITORIAL", "SEO", "DISCOVER", "AI_VISIBILITY"]
      }
    },
    "message": { "type": "string" },
    "route": {
      "type": "string",
      "enum": [
        "EDITORIAL",
        "RESEARCH",
        "SEO_TECHNICAL",
        "CONTENT_STRATEGY",
        "VISUAL_DESIGN",
        "SITE_TECHNICAL",
        "PUBLISHING",
        "HUMAN_REVIEW"
      ]
    },
    "blocking": { "type": "boolean" },
    "originalCodes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "location": { "type": "string" },
    "recommendation": { "type": "string" }
  },
  "additionalProperties": false
}
