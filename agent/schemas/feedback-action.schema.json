{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NexaMOS Feedback Action Schema",
  "type": "object",
  "required": [
    "id",
    "target",
    "actionType",
    "priority",
    "reason",
    "originArticleId",
    "supportingDiagnosisIds",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": { "type": "string" },
    "target": {
      "type": "string",
      "enum": [
        "TOPIC",
        "RESEARCH",
        "EDITORIAL",
        "SEO",
        "DISCOVER",
        "AI_VISIBILITY",
        "VISUAL",
        "PUBLISHING",
        "CONTENT_STRATEGY",
        "HUMAN_REVIEW"
      ]
    },
    "actionType": {
      "type": "string",
      "enum": [
        "REVIEW_TOPIC",
        "PRIORITIZE_FOLLOW_UP",
        "CREATE_UPDATE_TOPIC",
        "REFRESH_RESEARCH",
        "UPDATE_ARTICLE",
        "TEST_TITLE",
        "IMPROVE_INTERNAL_LINKING",
        "IMPROVE_VISUAL",
        "REVIEW_SEARCH_INTENT",
        "EXPAND_TOPIC_CLUSTER",
        "NO_ACTION"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "reason": { "type": "string" },
    "originArticleId": { "type": "string" },
    "supportingDiagnosisIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "payload": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": ["PROPOSED", "ROUTED", "ACKNOWLEDGED", "DISMISSED"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "routedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
