{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NexaMOS Google Generative AI Eligibility Schema",
  "type": "object",
  "required": ["eligibility", "inclusionStatus"],
  "properties": {
    "eligibility": {
      "type": "string",
      "enum": ["ELIGIBLE", "ELIGIBILITY_WARNING", "INELIGIBLE", "BLOCKED_BY_SITE_CONTROL"]
    },
    "inclusionStatus": {
      "type": "string",
      "enum": ["INCLUDED", "EXCLUDED", "UNKNOWN"]
    },
    "indexable": { "type": "boolean" },
    "primaryContentAvailable": { "type": "boolean" },
    "snippetRestricted": { "type": "boolean" },
    "canonicalValid": { "type": "boolean" }
  }
}
