{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NexaMOS Provider-Neutral AI Readiness Schema",
  "type": "object",
  "required": [
    "retrievability",
    "answerability",
    "entityClarity",
    "claimTraceability",
    "sourceTransparency",
    "informationGain"
  ],
  "properties": {
    "retrievability": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"]
    },
    "answerability": {
      "type": "string",
      "enum": ["STRONG", "ADEQUATE", "WEAK"]
    },
    "entityClarity": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"]
    },
    "claimTraceability": {
      "type": "string",
      "enum": ["FULL", "PARTIAL", "UNSUPPORTED"]
    },
    "sourceTransparency": {
      "type": "string",
      "enum": ["TRANSPARENT", "NEEDS_IMPROVEMENT", "OPAQUE"]
    },
    "informationGain": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"]
    }
  }
}
