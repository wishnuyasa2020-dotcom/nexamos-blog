{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexamos.com/schemas/research-evidence.schema.json",
  "title": "NexaMOS Research Evidence",
  "description": "Canonical schema for a specific extract, quote, metric, or empirical observation supporting or refuting claims.",
  "type": "object",
  "required": [
    "id",
    "sourceId",
    "researchProjectId",
    "content",
    "evidenceLevel",
    "capturedAt",
    "publicationAllowed",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "researchProjectId": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "page": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "lineRange": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "figure": {
          "type": [
            "string",
            "null"
          ]
        },
        "paragraph": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidenceLevel": {
      "type": "string",
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ]
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "publicationAllowed": {
      "type": "boolean"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
